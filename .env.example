# Copy to .env and fill in locally. Never commit .env.
# API key of the cloud LLM provider in use; read by ragshelf.config
# load_secrets(). Only the key of the provider selected by llm.cloud_provider
# is needed. Model and provider defaults are defined in src/ragshelf/config.py
# and can be overridden in ragshelf.toml.
# DeepSeek platform (default provider):
DEEPSEEK_API_KEY=
# OpenRouter (alternative provider):
OPENROUTER_API_KEY=

# Only secrets belong in this file. Non-secret settings live in ragshelf.toml
# and can be overridden with RAGSHELF_* variables set in the process
# environment (not here), for example RAGSHELF_LLM__ROUTE=local.

# Keep model downloads, caches, and tool state inside the project (relative to
# the repository root) instead of the user profile. The package does not read
# these lines: code that uses ragshelf.config sets the variables itself with
# apply_environment(). They are a reference for tools started by hand, such as
# `mineru-kit parse`, where the variables must be set in the shell.
HF_HOME=models/hf
MINERU_HOME=models/mineru
# Opt out of telemetry.
HF_HUB_DISABLE_TELEMETRY=1
MINERU_TELEMETRY_DISABLED=1
