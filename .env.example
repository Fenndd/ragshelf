# Copy to .env and fill in locally. Never commit .env.
# OpenRouter API key (the variable name is kept from the prototype). Read by
# src/ragshelf/generation/rag_chain.py and src/ragshelf/retrieval/reranker.py;
# the model is set in src/ragshelf/llm/deepseek_llm.py.
DEEPSEEK_API_KEY=

# Only secrets belong in this file. Non-secret settings live in ragshelf.toml
# and can be overridden with RAGSHELF_* variables set in the process
# environment (not here), for example RAGSHELF_LLM__ROUTE=local.

# Keep model downloads, caches, and tool state inside the project (relative to
# the repository root) instead of the user profile. Code that uses
# ragshelf.config sets these itself with apply_environment(); the lines below
# remain for the prototype modules that still call load_dotenv().
HF_HOME=models/hf
MINERU_HOME=models/mineru
# Opt out of telemetry.
HF_HUB_DISABLE_TELEMETRY=1
MINERU_TELEMETRY_DISABLED=1
